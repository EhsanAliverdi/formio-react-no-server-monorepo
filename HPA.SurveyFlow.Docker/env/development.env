COMPOSE_PROJECT_NAME=hpa-surveyflow-development
APP_ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development
API_APP_VERSION=local
BUILD_TIME=local

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=surveyflow
POSTGRES_USER=surveyflow
POSTGRES_PASSWORD=surveyflow123

# MinIO / S3
MINIO_HOST=minio
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_API_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=uploads
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Chromium (headless browser for PDF)
CHROMIUM_HOST=chromium
CHROMIUM_PORT=3000
CHROMIUM_WS_ENDPOINT=ws://chromium:3000

# Seeding
SEED_ADMIN_USER=true
SEED_FORMS=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Ports exposed on host
API_PORT=5000
WEB_DEV_PORT=4200

# Web / Nginx
ANGULAR_API_BASE_URL=/api
API_PROXY_TARGET=http://api:5000
CHOKIDAR_USEPOLLING=true

# OpenTelemetry — API (server-side)
# Set APPLICATIONINSIGHTS_CONNECTION_STRING to route telemetry to Azure Application Insights instead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
APPLICATIONINSIGHTS_CONNECTION_STRING=
ASPIRE_AUTH_MODE=Unsecured
ASPIRE_OTLP_AUTH_MODE=Unsecured
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_OTLP_PORT=18889
ASPIRE_HTTP_OTLP_PORT=4318

# OpenTelemetry — Web (browser-side, baked into Angular at build time)
# OTLP endpoint must be reachable from the browser, not from inside Docker.
# The Aspire Dashboard HTTP OTLP port (4318) is exposed on the host for this.
WEB_TELEMETRY_ENABLED=false
WEB_TELEMETRY_OTLP_ENDPOINT=http://localhost:4318
