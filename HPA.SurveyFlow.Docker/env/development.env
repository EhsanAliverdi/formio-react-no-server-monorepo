COMPOSE_PROJECT_NAME=hpa-surveyflow-development
APP_ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development
API_APP_VERSION=local
BUILD_TIME=local

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=surveyflow
POSTGRES_USER=surveyflow
POSTGRES_PASSWORD=surveyflow123

# MinIO / S3
MINIO_HOST=minio
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_API_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=uploads
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Chromium (headless browser for PDF)
CHROMIUM_HOST=chromium
CHROMIUM_PORT=3000
CHROMIUM_WS_ENDPOINT=ws://chromium:3000

# ── Seeding ────────────────────────────────────────────────────────────────────
# Each flag controls an independent category of seed data. All default to false.
# Set to true to create that data on startup (safe to re-run — idempotent by default).
# SEED_DASHBOARDS requires SEED_REPORTS to have run first (dashboard cards reference report template IDs).
#
# SEED_OVERRIDE  — update existing seed rows with latest values (non-destructive)
# SEED_RESET     — DELETE existing seed rows then re-insert (clean slate — dev only!)

SEED_ADMIN_USER=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

SEED_DEMO_USERS=true
SEED_FORMS=true
SEED_RULES=true
SEED_REPORTS=true
SEED_DASHBOARDS=true
SEED_SUBMISSIONS=true
SEED_DATASETS=true
SEED_SCHEDULES=true
SEED_PAGES=false

SEED_OVERRIDE=true
SEED_RESET=true

# Ports exposed on host
API_PORT=5000
WEB_DEV_PORT=4200

# Web / Nginx
ANGULAR_API_BASE_URL=/api
API_PROXY_TARGET=http://api:5000
CHOKIDAR_USEPOLLING=true

# Email provider (smtp | sendgrid | resend)
# Set via site settings in the DB — these are reference values only.
# integration.email.provider=resend
# integration.email.testMode=true         # resend: uses onboarding@resend.dev; sendgrid: sandbox mode
# integration.email.resendApiKey=re_xxxxxxxxxxxxxxxxxxxx
# integration.email.sendgridApiKey=SG.xxxxxxxxxxxxxxxxxxxx
# integration.email.fromEmail=noreply@yourdomain.com
# integration.email.fromName=SurveyFlow
