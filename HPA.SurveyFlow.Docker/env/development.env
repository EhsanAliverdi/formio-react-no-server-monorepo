COMPOSE_PROJECT_NAME=hpa-surveyflow-development
APP_ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development
API_APP_VERSION=local
BUILD_TIME=local

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=surveyflow
POSTGRES_USER=surveyflow
POSTGRES_PASSWORD=surveyflow123

# MinIO / S3
MINIO_HOST=minio
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_API_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=uploads
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Chromium (headless browser for PDF)
CHROMIUM_HOST=chromium
CHROMIUM_PORT=3000
CHROMIUM_WS_ENDPOINT=ws://chromium:3000

# Seeding
SEED_ADMIN_USER=true
SEED_FORMS=true
SEED_OVERRIDE_EXISTING=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Ports exposed on host
API_PORT=5000
WEB_DEV_PORT=4200

# Web / Nginx
ANGULAR_API_BASE_URL=/api
API_PROXY_TARGET=http://api:5000
CHOKIDAR_USEPOLLING=true
