COMPOSE_PROJECT_NAME=hpa-surveyflow-uat
APP_ENVIRONMENT=uat
ASPNETCORE_ENVIRONMENT=Production
API_APP_VERSION=uat
BUILD_TIME=replace-at-build

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=surveyflow
POSTGRES_USER=surveyflow
POSTGRES_PASSWORD=change-me-in-octopus

# MinIO / S3
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_ROOT_USER=surveyflow
MINIO_ROOT_PASSWORD=change-me-in-octopus
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=uploads
MINIO_ACCESS_KEY=surveyflow
MINIO_SECRET_KEY=change-me-in-octopus

# Chromium (headless browser for PDF)
CHROMIUM_HOST=chromium
CHROMIUM_PORT=3000
CHROMIUM_WS_ENDPOINT=ws://chromium:3000

# Seeding
SEED_ADMIN_USER=false
SEED_FORMS=false
ADMIN_EMAIL=replace-in-octopus
ADMIN_PASSWORD=replace-in-octopus

# Web / Nginx
ANGULAR_API_BASE_URL=/api
API_PROXY_TARGET=http://api:5000
WEB_HOST=surveyflow-uat.example.com
API_HOST=api.surveyflow-uat.example.com

# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD=false

# OpenTelemetry — API (server-side)
# Set connection string to use Azure Application Insights instead of Aspire Dashboard.
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
APPLICATIONINSIGHTS_CONNECTION_STRING=replace-in-octopus
ASPIRE_AUTH_MODE=BrowserToken
ASPIRE_OTLP_AUTH_MODE=ApiKey

# OpenTelemetry — Web (browser-side, baked into Angular at build time)
# Endpoint must be a public URL reachable from user browsers.
WEB_TELEMETRY_ENABLED=false
WEB_TELEMETRY_OTLP_ENDPOINT=replace-in-octopus
