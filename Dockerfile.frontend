# Frontend (Vite) build served by nginx
FROM node:20-alpine AS build

WORKDIR /app/frontend

# Vite reads VITE_* variables at build time.
ARG VITE_API_BASE_URL
ARG VITE_APP_VERSION
ARG VITE_BUILD_TIME
ARG VITE_APP_ENVIRONMENT
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_BUILD_TIME=$VITE_BUILD_TIME
ENV VITE_APP_ENVIRONMENT=$VITE_APP_ENVIRONMENT

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Bake version + build time into a generated module so it is always present.
# If VITE_BUILD_TIME isn't provided, use the current UTC time.
RUN set -eu; \
	BUILD_TIME_VALUE="${VITE_BUILD_TIME:-}"; \
	if [ -z "$BUILD_TIME_VALUE" ]; then BUILD_TIME_VALUE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; fi; \
	APP_VERSION_VALUE="${VITE_APP_VERSION:-}"; \
	if [ -z "$APP_VERSION_VALUE" ]; then APP_VERSION_VALUE="$(node -p 'require("./package.json").version')"; fi; \
	APP_ENV_VALUE="${VITE_APP_ENVIRONMENT:-}"; \
	if [ -z "$APP_ENV_VALUE" ]; then APP_ENV_VALUE="development"; fi; \
	mkdir -p src/generated; \
	printf '%s\n' \
		'// Generated during Docker build.' \
		'export const appVersion: string = '"\"$APP_VERSION_VALUE\""';' \
		'export const buildTime: string = '"\"$BUILD_TIME_VALUE\""';' \
		'export const appEnvironment: string = '"\"$APP_ENV_VALUE\""';' \
		> src/generated/buildInfo.ts

RUN npm run build

FROM nginx:1.27-alpine AS runtime

# SPA routing support
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
