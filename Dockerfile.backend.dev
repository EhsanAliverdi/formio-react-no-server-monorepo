# Development Backend Dockerfile
# This image only installs dependencies. Source code is mounted at runtime.

FROM node:20-bullseye-slim

WORKDIR /app/backend

# Install system dependencies for Prisma
RUN apt-get update -y \
	&& apt-get install -y --no-install-recommends openssl libssl1.1 ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Optional: add corporate root CA certs for Docker builds.
# Place one or more *.crt files in backend/certs/ and rebuild.
COPY backend/certs/ /usr/local/share/ca-certificates/
RUN update-ca-certificates || true

# Ensure Node can use the system CA bundle (including any added certs).
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Handle TLS certificate issues in corporate environments
ARG INSECURE_TLS=false

# Install dependencies (will be cached unless package files change)
COPY backend/package.json backend/package-lock.json ./
RUN if [ "$INSECURE_TLS" = "true" ]; then \
		export NODE_TLS_REJECT_UNAUTHORIZED=0; \
		export npm_config_strict_ssl=false; \
	fi \
	&& npm install

# Install Chromium for Playwright (used for PDF generation)
ENV PLAYWRIGHT_BROWSERS_PATH=0
RUN if [ "$INSECURE_TLS" = "true" ]; then export NODE_TLS_REJECT_UNAUTHORIZED=0; fi \
	&& npx playwright install chromium

# Development mode: source code is mounted via bind mount
# We only copy the Prisma schema here to generate the client
COPY backend/prisma ./prisma
RUN if [ "$INSECURE_TLS" = "true" ]; then \
		export NODE_TLS_REJECT_UNAUTHORIZED=0; \
		export npm_config_strict_ssl=false; \
	fi \
	&& npx prisma generate

# Expose dev server port
EXPOSE 3000

# Run Next.js dev server (Fast Refresh enabled by default)
# The -H flag binds to all interfaces so Docker can forward
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
