# Angular 19 frontend — development mode with hot reload
# Source code is mounted at runtime; node_modules preserved in a named volume.

FROM node:22-alpine

WORKDIR /app/angular-frontend

# Install dependencies (cached layer; source bind-mount overlays at runtime)
COPY angular-frontend/package.json angular-frontend/package-lock.json ./
RUN npm install

# Development mode: source code is mounted via bind mount in docker-compose.override.yml
# proxy.conf.json forwards /api → http://dotnet-backend:5000

EXPOSE 4200

# --host 0.0.0.0 makes the dev server reachable from outside the container
# --port 4200 is explicit for clarity
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--port", "4200"]
