generator client {
  provider   = "prisma-client-js"
  // Use the Node-API query engine to avoid native OpenSSL
  // library compatibility issues in Docker images.
  engineType = "node-api"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("admin")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Profile fields
  displayName   String?  @map("display_name")
  preferredName String?  @map("preferred_name")
  firstName     String?  @map("first_name")
  middleName    String?  @map("middle_name")
  lastName      String?  @map("last_name")
  pronouns      String?
  dateOfBirth   String?  @map("date_of_birth")
  phone         String?
  jobTitle      String?  @map("job_title")
  department    String?
  company       String?
  websiteUrl    String?  @map("website_url")
  bio           String?
  addressLine1  String?  @map("address_line1")
  addressLine2  String?  @map("address_line2")
  city          String?
  state         String?
  postalCode    String?  @map("postal_code")
  country       String?
  timezone      String?
  locale        String?
  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true) @map("is_active")

  sessions      Session[]
  submissions   FormSubmission[]
  notifications Notification[] @relation("NotificationCreator")
  notificationRecipients NotificationRecipient[]
  allowedForms  FormAllowedUser[]

  @@map("users")
}

model Form {
  id                   Int                @id @default(autoincrement())
  name                 String
  json                 String
  allowAnonymousSubmit Boolean            @default(true) @map("allow_anonymous_submit")
  visibility           String             @default("public")

  submissions          FormSubmission[]
  allowedRoles         FormAllowedRole[]
  allowedUsers         FormAllowedUser[]

  @@map("forms")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model FormSubmission {
  id          Int       @id @default(autoincrement())
  formId      Int       @map("form_id")
  userId      Int?      @map("user_id")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  data        String
  updatedAt   DateTime? @map("updated_at")
  updatedBy   Int?      @map("updated_by")
  editHistory String?   @map("edit_history")

  form        Form      @relation(fields: [formId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@map("form_submissions")
}

model Notification {
  id         Int                      @id @default(autoincrement())
  title      String
  body       String
  type       String                   @default("info")
  level      String                   @default("normal")
  createdBy  Int?                     @map("created_by")
  createdAt  DateTime                 @default(now()) @map("created_at")

  creator    User?                    @relation("NotificationCreator", fields: [createdBy], references: [id])
  recipients NotificationRecipient[]

  @@map("notifications")
}

model NotificationRecipient {
  notificationId Int       @map("notification_id")
  userId         Int       @map("user_id")
  deliveredAt    DateTime  @default(now()) @map("delivered_at")
  readAt         DateTime? @map("read_at")

  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@id([notificationId, userId])
  @@map("notification_recipients")
}

model SiteSetting {
  key   String @id
  value String

  @@map("site_settings")
}

model FormAllowedRole {
  formId Int    @map("form_id")
  role   String

  form   Form   @relation(fields: [formId], references: [id])

  @@id([formId, role])
  @@map("form_allowed_roles")
}

model FormAllowedUser {
  formId Int @map("form_id")
  userId Int @map("user_id")

  form   Form @relation(fields: [formId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([formId, userId])
  @@map("form_allowed_users")
}
