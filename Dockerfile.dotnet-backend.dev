FROM mcr.microsoft.com/dotnet/sdk:10.0

# Install Chromium for PuppeteerSharp
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium libglib2.0-0 libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libxcb1 libxkbcommon0 libx11-6 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
    libasound2 libfontconfig1 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:5000
ENV DOTNET_USE_POLLING_FILE_WATCHER=true

WORKDIR /app/dotnet-backend
EXPOSE 5000

CMD ["dotnet", "watch", "--project", "SurveyFlow.Api", "run", "--no-hot-reload", "--urls", "http://+:5000"]
