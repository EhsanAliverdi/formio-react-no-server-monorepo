{
  "version": "2.0.0",
  "tasks": [
    // Development Mode Tasks (uses docker-compose.override.yml automatically)
    {
      "label": "Docker: Start Dev Mode",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Start Dev Mode (Logs)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Rebuild Dev Mode",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Stop Dev Mode",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "down"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart Backend (Dev)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "restart",
        "backend"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart Frontend (Dev)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "restart",
        "frontend"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: View Backend Logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "logs",
        "-f",
        "backend"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: View Frontend Logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "logs",
        "-f",
        "frontend"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // Production Mode Tasks
    {
      "label": "Docker: Build Production",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "--env-file",
        ".env.prod",
        "-f",
        "docker-compose.yml",
        "build"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Start Production",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "--env-file",
        ".env.prod",
        "-f",
        "docker-compose.yml",
        "up",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop Production",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "-f",
        "docker-compose.yml",
        "down"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: View Production Logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "-f",
        "docker-compose.yml",
        "logs",
        "-f"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // Database Tasks
    {
      "label": "Docker: Seed Database",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "exec",
        "backend",
        "npm",
        "run",
        "seed"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Prisma Generate",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "exec",
        "backend",
        "npx",
        "prisma",
        "generate"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Prisma DB Push",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "exec",
        "backend",
        "npx",
        "prisma",
        "db",
        "push"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    // Mobile (Capacitor) Tasks
    {
      "label": "Mobile: Build Frontend (Capacitor)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Mobile: Capacitor Sync",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "cap:sync"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Mobile: Run Android (Capacitor)",
      "type": "shell",
      "command": "npx",
      "args": [
        "cap",
        "run",
        "android"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Mobile: Run iOS (Capacitor)",
      "type": "shell",
      "command": "npx",
      "args": [
        "cap",
        "run",
        "ios"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}
