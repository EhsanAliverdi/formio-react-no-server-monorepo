{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Dev Up",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "up", "-d"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Dev Up With Logs",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "up"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Dev Rebuild",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "up", "--build", "-d"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Dev Down",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "down"],
      "problemMatcher": []
    },
    {
      "label": "Docker: UAT Config",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/uat.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.uat.yml", "config"],
      "problemMatcher": []
    },
    {
      "label": "Docker: Prod Config",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/production.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.production.yml", "config"],
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart API",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "restart", "api"],
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart Web",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "restart", "web"],
      "problemMatcher": []
    },
    {
      "label": "EF: Add Migration",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "exec", "api", "dotnet", "ef", "migrations", "add", "${input:migrationName}", "--project", "HPA.SurveyFlow.Infrastructure", "--startup-project", "HPA.SurveyFlow.Api"],
      "problemMatcher": []
    },
    {
      "label": "EF: Update Database",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "--env-file", "HPA.SurveyFlow.Docker/env/development.env", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.yml", "-f", "HPA.SurveyFlow.Docker/compose/docker-compose.development.yml", "exec", "api", "dotnet", "ef", "database", "update", "--project", "HPA.SurveyFlow.Infrastructure", "--startup-project", "HPA.SurveyFlow.Api"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Migration name, for example AddUserTable"
    }
  ]
}
