      "label": "Docker: Prod Up",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "hpa-surveyflow-prod",
        "--env-file",
        ".env.production",
        "-f",
        "Docker/docker-compose.yml",
        "up",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": []
