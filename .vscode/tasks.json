    {
      "label": "Docker: Prod Build",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "hpa-surveyflow-prod",
        "--env-file",
        ".env.production",
        "-f",
        "Docker/docker-compose.yml",
        "build"
      ],
      "problemMatcher": []
