{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Dev Up",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "-f",
        "Docker/docker-compose.yml",
        "-f",
        "Docker/docker-compose.override.yml",
        "up",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Dev Up With Logs",
