{
  "version": "2.0.0",
  "tasks": [
    // Development Mode Tasks (uses docker-compose.override.yml automatically)
    {
      "label": "Docker: Start Dev Mode",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "up",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Start Dev Mode (Logs)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Rebuild Dev Mode",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "up",
        "--build",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Stop Dev Mode",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "down"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart Backend (Dev)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "restart",
        "dotnet-backend"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Restart Frontend (Dev)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "restart",
        "angular-frontend"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: View Backend Logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "logs",
        "-f",
        "dotnet-backend"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: View Frontend Logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "logs",
        "-f",
        "angular-frontend"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // Production Mode Tasks
    {
      "label": "Docker: Build Production",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "--env-file",
        ".env.production",
        "-f",
        "docker-compose.yml",
        "build"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: Start Production",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "--env-file",
        ".env.production",
        "-f",
        "docker-compose.yml",
        "up",
        "-d"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop Production",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "-f",
        "docker-compose.yml",
        "down"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: View Production Logs",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-p",
        "surveyflow-prod",
        "-f",
        "docker-compose.yml",
        "logs",
        "-f"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // Database Tasks
    {
      "label": "Docker: EF Migrations Add",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "exec",
        "dotnet-backend",
        "dotnet",
        "ef",
        "migrations",
        "add",
        "${input:migrationName}",
        "--project",
        "SurveyFlow.Infrastructure",
        "--startup-project",
        "SurveyFlow.Api"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Docker: EF Database Update",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.development",
        "exec",
        "dotnet-backend",
        "dotnet",
        "ef",
        "database",
        "update",
        "--project",
        "SurveyFlow.Infrastructure",
        "--startup-project",
        "SurveyFlow.Api"
      ],
      "isBackground": false,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Migration name (e.g. AddUserTable)"
    }
  ]
}