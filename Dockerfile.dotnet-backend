# ── Dev stage ─────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS dev

ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:5000
ENV DOTNET_USE_POLLING_FILE_WATCHER=true

RUN dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/root/.dotnet/tools"

WORKDIR /app/dotnet-backend

# Pre-restore NuGet packages (cached layer — only reruns when .csproj files change)
COPY dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj SurveyFlow.Api/
COPY dotnet-backend/SurveyFlow.Core/SurveyFlow.Core.csproj SurveyFlow.Core/
COPY dotnet-backend/SurveyFlow.Infrastructure/SurveyFlow.Infrastructure.csproj SurveyFlow.Infrastructure/
RUN dotnet restore SurveyFlow.Api/SurveyFlow.Api.csproj

EXPOSE 5000
CMD ["dotnet", "watch", "--project", "SurveyFlow.Api", "run", "--no-hot-reload", "--urls", "http://+:5000"]

# ── Build stage ────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY dotnet-backend/SurveyFlow.Core/SurveyFlow.Core.csproj            dotnet-backend/SurveyFlow.Core/
COPY dotnet-backend/SurveyFlow.Infrastructure/SurveyFlow.Infrastructure.csproj dotnet-backend/SurveyFlow.Infrastructure/
COPY dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj               dotnet-backend/SurveyFlow.Api/
COPY dotnet-backend/SurveyFlow.slnx                                     dotnet-backend/
RUN dotnet restore dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj

COPY dotnet-backend/ dotnet-backend/
RUN dotnet publish dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj \
    -c Release -o /app/publish --no-restore

# ── Prod stage ─────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS prod

ARG APP_VERSION
ARG BUILD_TIME
ARG APP_ENVIRONMENT=production

ENV APP_VERSION=${APP_VERSION}
ENV BUILD_TIME=${BUILD_TIME}
ENV APP_ENVIRONMENT=${APP_ENVIRONMENT}
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 5000
ENTRYPOINT ["dotnet", "SurveyFlow.Api.dll"]
