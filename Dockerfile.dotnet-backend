# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore (layered for better caching)
COPY dotnet-backend/SurveyFlow.Core/SurveyFlow.Core.csproj            dotnet-backend/SurveyFlow.Core/
COPY dotnet-backend/SurveyFlow.Infrastructure/SurveyFlow.Infrastructure.csproj dotnet-backend/SurveyFlow.Infrastructure/
COPY dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj               dotnet-backend/SurveyFlow.Api/
COPY dotnet-backend/SurveyFlow.slnx                                     dotnet-backend/

RUN dotnet restore dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj

# Build and publish
COPY dotnet-backend/ dotnet-backend/
RUN dotnet publish dotnet-backend/SurveyFlow.Api/SurveyFlow.Api.csproj \
    -c Release -o /app/publish --no-restore

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

# Install Chromium for PuppeteerSharp PDF generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxcb1 \
    libxkbcommon0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libfontconfig1 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

WORKDIR /app
COPY --from=build /app/publish .

ARG APP_VERSION
ARG BUILD_TIME
ARG APP_ENVIRONMENT=production

ENV APP_VERSION=${APP_VERSION}
ENV BUILD_TIME=${BUILD_TIME}
ENV APP_ENVIRONMENT=${APP_ENVIRONMENT}
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 5000

ENTRYPOINT ["dotnet", "SurveyFlow.Api.dll"]
