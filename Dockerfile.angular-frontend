# ── Dev stage ─────────────────────────────────────────────────────────────────
FROM node:22-alpine AS dev

WORKDIR /app/angular-frontend

COPY angular-frontend/.npmrc angular-frontend/package.json angular-frontend/package-lock.json ./
RUN npm install

EXPOSE 4200
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--port", "4200"]

# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

ARG ANGULAR_API_BASE_URL

WORKDIR /app/angular-frontend

COPY angular-frontend/.npmrc angular-frontend/package.json angular-frontend/package-lock.json ./
RUN npm ci

COPY angular-frontend/ ./
RUN npm run build

# ── Prod stage ─────────────────────────────────────────────────────────────────
FROM nginx:alpine AS prod

COPY nginx.angular.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/angular-frontend/dist/angular-frontend/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
