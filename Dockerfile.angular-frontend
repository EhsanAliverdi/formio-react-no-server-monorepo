# Angular 19 frontend — multi-stage production build served by nginx
# Build stage: compile with esbuild via @angular/build
FROM node:22-alpine AS build

WORKDIR /app/angular-frontend

# Optional: passed through to environment.prod.ts replacement if needed
ARG ANGULAR_API_BASE_URL

# Install dependencies using lockfile for reproducibility
COPY angular-frontend/.npmrc angular-frontend/package.json angular-frontend/package-lock.json ./
RUN npm ci

# Copy source and build (defaults to production configuration)
COPY angular-frontend/ ./
RUN npm run build

# Runtime stage: serve static output with nginx
FROM nginx:alpine AS runtime

COPY nginx.angular.conf /etc/nginx/conf.d/default.conf

# Angular application builder outputs to dist/<project-name>/browser/
COPY --from=build /app/angular-frontend/dist/angular-frontend/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
